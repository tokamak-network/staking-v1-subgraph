{
  "extends": "@graphprotocol/graph-ts/types/tsconfig.base.json",
  "include": ["src", "types"],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@/generated": ["./generated"],
      "@/schema": ["./generated/schema"],
      "@/candidate": ["./generated/Candidate/Candidate"],
      "@/constants": ["./constants"],
      "@/utils": ["./utils"],
      "@/types": ["./types"]
    },
    "moduleResolution": "Node" // or "Classic"
  }
}
